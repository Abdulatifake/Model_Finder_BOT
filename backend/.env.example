# --- Telegram Bot (BotFather) ---
BOT_TOKEN=

# --- Manba kanal (3D modellar shu yerdan olinadi) ---
CHANNEL_USERNAME=PROMODELS2028

# --- Neon PostgreSQL ---
# Ilova uchun: pooler manzili (hostda "-pooler" bor) + &connect_timeout=15
# pgbouncer=true QO'SHMANG — Neon pooler prepared statement'larni qo'llaydi, bayroq esa har so'rovni 5 barobar sekinlashtiradi
DATABASE_URL=
# Migratsiyalar uchun: xuddi shu manzil, lekin hostda "-pooler" qismisiz
DIRECT_URL=

# --- Server ---
PORT=4100

# --- Mini App manzili ---
# Lokal: TUNNEL=cloudflared bo'lsa, server manzilni o'zi oladi va botga o'rnatadi.
# Serverda (Render): TUNNEL bo'sh, MINI_APP_URL = Vercel'dagi Mini App manzili.
TUNNEL=cloudflared
MINI_APP_URL=

# --- Serverda (Render) — lokal ishlashda bo'sh qoldiring ---
# Backend'ning ommaviy manzili (Render uni RENDER_EXTERNAL_URL orqali o'zi beradi). Bo'lsa — bot webhook rejimida ishlaydi.
PUBLIC_URL=
# Vercel'dagi Mini App va admin panel manzillari, vergul bilan
ALLOWED_ORIGINS=
# Doimiy disk (rasmlar, yuklamalar, AI modellar keshi)
DATA_DIR=

# --- Admin panelga kirish paroli va token imzosi kaliti (istalgan uzun tasodifiy matn) ---
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# --- Mini App'ni Telegram'siz, oddiy brauzerda sinash (faqat shu kompyuterdan ishlaydi) ---
ALLOW_DEV_BYPASS=false

# --- Telegram Desktop eksport papkasi (faqat import skripti uchun) ---
EXPORT_DIR=
